SOURCE_SPECIALS_URL=https://broadway.shop.tuckerfresh.com.au/specials
# Safe local default. Production GitHub Actions explicitly uses MAX_PRODUCTS=none.
MAX_PRODUCTS=100
PAGE_SIZE=9

LIST_PAGE_DELAY_MIN_SECONDS=3
LIST_PAGE_DELAY_MAX_SECONDS=6
IMAGE_DELAY_MIN_SECONDS=5
IMAGE_DELAY_MAX_SECONDS=8
IMAGE_TIMEOUT_SECONDS=30
IMAGE_MAX_ATTEMPTS=3
# Leave empty locally. Production GitHub Actions uses 18000 (five hours).
IMAGE_SYNC_BUDGET_SECONDS=

B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Safe local namespace. Production GitHub Actions explicitly uses B2_PREFIX=prod.
B2_PREFIX=test

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=
